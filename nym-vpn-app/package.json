{
  "name": "nym-vpn-app",
  "version": "0.0.0",
  "type": "module",
  "author": "Pierre Dommerc <dommerc.pierre@gmail.com>",
  "contributors": [
    "Zane Schepke <zanecschepke@gmail.com>",
    "Nym team"
  ],
  "description": "NymVPN desktop client",
  "license": "GPL-3.0-only",
  "repository": "github:nymtech/nym-vpn-client",
  "scripts": {
    "dev": "vite",
    "dev:app": "tauri dev",
    "dev:browser": "vite --mode dev-browser",
    "check": "run-s lint tscheck fmt",
    "build": "tsc && vite build",
    "build:app": "npm run tauri build",
    "preview": "vite preview",
    "lint": "eslint src/",
    "lint:fix": "eslint --fix src/",
    "fmt": "prettier --write --ignore-unknown \"**/*\"",
    "fmt:check": "prettier --check --ignore-unknown \"**/*\"",
    "tscheck": "tsc --noEmit",
    "tsgen": "cd src-tauri && cargo test && prettier --write ../src/types/tauri.ts",
    "tauri": "tauri",
    "gen:licenses": "run-p --aggregate-output gen:licenses:rust gen:licenses:js",
    "gen:licenses:js": "npx --yes license-checker-rseidelsohn@4.4.2 --production --json --depth 0 > public/licenses-js.json",
    "gen:licenses:rust": "cargo license -j --avoid-dev-deps --avoid-build-deps --manifest-path src-tauri/Cargo.toml > public/licenses-rust.json"
  },
  "dependencies": {
    "@base-ui-components/react": "^1.0.0-beta.3",
    "@headlessui/react": "^2.1.2",
    "@lottiefiles/dotlottie-react": "^0.17.7",
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-slider": "^1.2.2",
    "@radix-ui/react-toast": "^1.2.6",
    "@tauri-apps/api": "=2.9.0",
    "@tauri-apps/plugin-autostart": "^2.5.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-notification": "^2.3.1",
    "@tauri-apps/plugin-opener": "^2.5.0",
    "@tauri-apps/plugin-os": "^2.3.1",
    "@tauri-apps/plugin-process": "^2.3.0",
    "@tauri-apps/plugin-updater": "^2.9.0",
    "@tauri-apps/plugin-window-state": "^2.4.0",
    "clsx": "^2.0.0",
    "dayjs": "^1.11.10",
    "dequal": "^2.0.3",
    "i18next": "^25.6.1",
    "i18next-browser-languagedetector": "^8.0.0",
    "lodash-es": "^4.17.21",
    "motion": "^12.4.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^16.2.4",
    "react-router": "^7.2.0",
    "react-virtualized-auto-sizer": "^1.0.23",
    "react-window": "^2.2.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@tailwindcss/vite": "^4.1.17",
    "@tauri-apps/cli": "=2.9.4",
    "@types/eslint__js": "^8.42.3",
    "@types/lodash-es": "^4.17.0",
    "@types/node": "^24.10.0",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react-swc": "^4.1.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react": "^7.34.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.0.0",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.3.3",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.0.2",
    "typescript-eslint": "^8.0.1",
    "vite": "^7.2.2",
    "vite-plugin-svgr": "^4.2.0"
  }
}
