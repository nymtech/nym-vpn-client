{
  "name": "nym-vpn-app",
  "version": "0.0.0",
  "type": "module",
  "author": "Nym Technologies SA <contact@nymtech.net>",
  "contributors": [
    "Nym team"
  ],
  "description": "NymVPN desktop client",
  "license": "GPL-3.0-only",
  "repository": "github:nymtech/nym-vpn-client",
  "scripts": {
    "dev": "vite",
    "dev:browser": "vite --mode dev-browser",
    "dev:app": "tauri dev",
    "check": "run-s lint tscheck fmt",
    "build": "tsc && vite build",
    "build:app": "npm run tauri build",
    "preview": "vite preview",
    "lint": "eslint src/",
    "lint:fix": "eslint --fix src/",
    "fmt": "prettier --write --ignore-unknown \"**/*\"",
    "fmt:check": "prettier --check --ignore-unknown \"**/*\"",
    "tscheck": "tsc --noEmit",
    "tsgen": "cd src-tauri && cargo test && prettier --write ../src/types/tauri.ts",
    "test:e2e": "npx playwright test --config=e2e/playwright.config.ts",
    "test:e2e:ui": "npx playwright test --config=e2e/playwright.config.ts --ui",
    "test:e2e:report": "npx playwright show-report playwright-report",
    "tauri": "tauri",
    "gen:licenses": "run-p --aggregate-output gen:licenses:rust gen:licenses:js",
    "gen:licenses:js": "npx --yes license-checker-rseidelsohn@4.4.2 --production --json --depth 0 > public/licenses-js.json",
    "gen:licenses:rust": "cargo license -j --avoid-dev-deps --avoid-build-deps --manifest-path src-tauri/Cargo.toml > public/licenses-rust.json"
  },
  "dependencies": {
    "@base-ui-components/react": "^1.0.0-rc.0",
    "@base-ui/react": "^1.6.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@headlessui/react": "^2.2.10",
    "@lottiefiles/dotlottie-react": "^0.19.12",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-toast": "^1.2.23",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-autostart": "^2.5.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.0",
    "@tauri-apps/plugin-deep-link": "^2.4.9",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-notification": "^2.3.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-os": "^2.3.1",
    "@tauri-apps/plugin-process": "^2.3.0",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@tauri-apps/plugin-window-state": "^2.4.0",
    "clsx": "^2.0.0",
    "country-region-data": "^4.1.0",
    "dayjs": "^1.11.21",
    "dequal": "^2.0.3",
    "embla-carousel-react": "^8.6.0",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "lodash-es": "^4.18.1",
    "motion": "^12.42.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "react-router": "^8.3.0",
    "react-window": "^2.2.7",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@playwright/test": "~1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "=2.11.4",
    "@types/eslint__js": "^8.42.3",
    "@types/lodash-es": "^4.17.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react": "^7.34.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.8.0",
    "npm-run-all2": "^9.0.3",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.2.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.2.0",
    "vite-plugin-svgr": "^5.2.0"
  }
}
