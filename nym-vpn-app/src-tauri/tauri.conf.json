{
  "productName": "NymVPN",
  "identifier": "net.nymtech.vpn",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": false,
    "longDescription": "NymVPN is a decentralized, mixnet hardened and privacy focused VPN.\n .\n Note: this is a client application and is intended to be used with\n the daemon service nym-vpnd.\n",
    "windows": {
      "nsis": {
        "template": "./bundle/windows/installer.nsi",
        "installMode": "perMachine",
        "installerIcon": "icons/nsis_icon.ico",
        "headerImage": "icons/nsis_header.bmp",
        "sidebarImage": "icons/nsis_sidebar.bmp"
      },
      "signCommand": {
        "cmd": "C:/Program Files/Git/bin/bash.EXE",
        "args": ["scripts/sign.sh", "%1"]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["nym-vpnd (>= 2026.12.2~beta.2)"],
        "desktopTemplate": "./bundle/deb/main.desktop"
      }
    }
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "$APPCACHE/**",
            "$HOME/.local/share/icons/**/*",
            "$HOME/.icons/**/*",
            "$HOME/.local/share/flatpak/**/*",
            "/var/lib/flatpak/exports/share/icons/**/*",
            "/usr/share/icons/**/*",
            "/usr/share/pixmaps/**/*",
            "/tmp/**/*",
            "/snap/**/*"
          ],
          "requireLiteralLeadingDot": false
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU3RjI2N0FFRUEyRERGOEQKUldTTjN5M3FybWZ5VjhxOFRsLzQ2c1N0NW1PVVNxVEVVQkszYjZHc3RtcEFDOW1ZN2lIN1NGdk0K",
      "windows": {
        "installMode": "passive"
      },
      "endpoints": [
        "https://raw.githubusercontent.com/nymtech/nym-vpn-client/refs/heads/develop/.pkg/tauri-updater/stable.json"
      ]
    },
    "deep-link": {
      "desktop": {
        "schemes": ["nymvpn"]
      }
    }
  }
}
