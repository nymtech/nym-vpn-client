# Maintainer: Andrej Mihajlov <andrej@nymtech.net>

pkgname=nym-vpnc-bin
pkgver=$PKGVER
pkgrel=$PKGREL
pkgdesc='NymVPN command-line client'
arch=('x86_64' 'aarch64')
url='https://github.com/nymtech/nym-vpn-client'
license=('GPL-3.0-only')
depends=('glibc' 'gcc-libs' 'polkit' 'nym-vpnd')
makedepends=()
provides=('nym-vpnc')
conflicts=('nym-vpnc')
options=(!debug)
source_x86_64=("$url/releases/download/${RELEASE_TAG}/nym-vpn-core-v${PKGVER}_linux_x86_64.tar.gz")
source_aarch64=("$url/releases/download/${RELEASE_TAG}/nym-vpn-core-v${PKGVER}_linux_aarch64.tar.gz")
sha256sums_x86_64=($TARBALL_SHA256_X86_64)
sha256sums_aarch64=($TARBALL_SHA256_AARCH64)

package() {
  install -Dm755 "nym-vpn-core-v${PKGVER}_linux_${CARCH}/nym-vpnc" "$pkgdir/usr/bin/nym-vpnc"
}
