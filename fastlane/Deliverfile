# Deliverfile — iOS App Store metadata upload (fastlane deliver)
#
# Metadata-only pipeline: uploads the App Store listing text under
# fastlane/metadata/ios/ to App Store Connect. No binary upload, no screenshots
# (deferred to a follow-up), and never auto-submits — a human submits the version.
# The App Store Connect API key is supplied at runtime by the :ios upload_metadata lane.

app_identifier "net.nymtech.vpn"

# Isolate from the Android `supply` metadata at fastlane/metadata/android.
metadata_path "./fastlane/metadata/ios"
screenshots_path "./fastlane/screenshots/ios"

# Listing text only.
skip_binary_upload true
skip_metadata false

# Screenshots: complete current sets for all 16 locales under fastlane/screenshots/ios
# (iPhone 6.5" 1242x2688 + iPad 13" 2752x2064, 9 each). Overwrite replaces the stale
# live screenshots. NOTE: overwrite_screenshots clears existing shots before upload —
# verify the first run (dry run / preview) before trusting it against prod.
skip_screenshots false
overwrite_screenshots true

# Default: no submission. The upload_metadata lane overrides this with its submit
# option, which the workflow's submit_for_review input (default false) sets — so a
# dispatch with that input true will submit the version for review.
submit_for_review false
automatic_release false

# Don't run the metadata precheck as a blocking gate here.
run_precheck_before_submit false

# CI is non-interactive: skip the HTML preview confirmation prompt.
force true
