default_platform(:android)

# Google Play supported metadata locales
# https://support.google.com/googleplay/android-developer/table/4419860?hl=en

platform :android do

	desc 'Deploy an internal version to Google Play'
	lane :internal do |options|
		gradle(task: "clean bundleGeneralRelease", project_dir: "nym-vpn-android/")
		skip_bundle = options[:skip_bundle]
		skip_metadata = options[:skip_metadata]
		upload_to_play_store(track: 'internal', skip_upload_apk: true, skip_upload_aab: skip_bundle, skip_upload_metadata: skip_metadata, skip_upload_changelogs: skip_metadata)
	end

	desc "Deploy an alpha version to Google Play"
	lane :alpha do |options|
		gradle(task: "clean bundleGeneralRelease", project_dir: "nym-vpn-android/")
		skip_bundle = options[:skip_bundle]
		skip_metadata = options[:skip_metadata]
		upload_to_play_store(track: 'alpha', skip_upload_apk: true, skip_upload_aab: skip_bundle, skip_upload_metadata: skip_metadata, skip_upload_changelogs: skip_metadata)
	end

	desc "Deploy a beta version to Google Play"
	lane :beta do |options|
		gradle(task: "clean bundleGeneralRelease", project_dir: "nym-vpn-android/")
		skip_bundle = options[:skip_bundle]
		skip_metadata = options[:skip_metadata]
		upload_to_play_store(track: 'beta', skip_upload_apk: true, skip_upload_aab: skip_bundle, skip_upload_metadata: skip_metadata, skip_upload_changelogs: skip_metadata)
	end

	desc "Deploy a production version to Google Play"
	lane :production do |options|
		gradle(task: "clean bundleGeneralRelease", project_dir: "nym-vpn-android/")
		skip_bundle = options[:skip_bundle]
		skip_metadata = options[:skip_metadata]
		upload_to_play_store(track: 'production', skip_upload_apk: true, skip_upload_aab: skip_bundle, skip_upload_metadata: skip_metadata, skip_upload_changelogs: skip_metadata)
	end
end

# --- Apple version bumps (global lanes) ---
# These set MARKETING_VERSION / CURRENT_PROJECT_VERSION on the shared Apple
# shipping targets (iOS app, extension, macOS daemon). They are not platform
# specific, so they are global lanes rather than a platform block. Moved here
# from nym-vpn-apple/fastlane when the Apple and Android fastlanes were combined
# into this single repo-root fastlane. The project path is repo-root-relative
# (fastlane runs from the fastlane-root = repo root), mirroring the Android
# `project_dir: "nym-vpn-android/"` convention above.

require 'xcodeproj' # ships with fastlane; required explicitly since this file is loaded in the Android context too

APPLE_PROJECT_PATH = 'nym-vpn-apple/NymVPN.xcodeproj'
APPLE_BUMP_TARGETS = ["NymVPN", "NymMixnetTunnel", "NymVPNDaemon", "NymVPND"]

desc "Bump Apple marketing version (MARKETING_VERSION) on the shipping targets"
lane :bump_version do
	app_version = ARGV[2]

	puts "App version to set: #{app_version}"

	if app_version.nil? || app_version.strip.empty?
		UI.user_error!("App version is missing. Please provide an app version, e.g., 'fastlane bump_version 1.3'")
	end

	project = Xcodeproj::Project.open(APPLE_PROJECT_PATH)

	project.targets.each do |projectTarget|
		if APPLE_BUMP_TARGETS.include?(projectTarget.name)
			projectTarget.build_configurations.each do |configuration|
				configuration.build_settings["MARKETING_VERSION"] = app_version
			end
		end
	end

	project.save
end

desc "Bump Apple build number (CURRENT_PROJECT_VERSION) on the shipping targets"
lane :bump_build do |options|
	# Optionally passed build number (string or int)
	provided_build = options[:build].to_i if options[:build]

	project = Xcodeproj::Project.open(APPLE_PROJECT_PATH)

	project.targets.each do |projectTarget|
		next unless APPLE_BUMP_TARGETS.include?(projectTarget.name)

		projectTarget.build_configurations.each do |configuration|
			current = configuration.build_settings["CURRENT_PROJECT_VERSION"].to_i
			new_build = provided_build && provided_build > 0 ? provided_build : (current + 1)

			configuration.build_settings["CURRENT_PROJECT_VERSION"] = new_build.to_s
			UI.message("✅ #{projectTarget.name}: #{current} → #{new_build}")
		end
	end

	project.save
end

