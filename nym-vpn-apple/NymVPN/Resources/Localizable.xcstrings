          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "端末の時刻が同期されていません。端末の時刻をインターネットと同期してください。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
