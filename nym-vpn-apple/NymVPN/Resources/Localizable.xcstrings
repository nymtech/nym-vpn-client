        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ডিফল্টভাবে Nym-এর সুপারিশকৃত DNS সার্ভার ব্যবহার করা হচ্ছে। প্রয়োজন হলে নিচে কাস্টম সার্ভার কনফিগার করুন।."
          }
