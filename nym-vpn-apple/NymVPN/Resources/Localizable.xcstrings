    "createAccount.dontLoosePassphraseSubtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قم بحفظها في مدير كلمة مرور موثوق بها أو قم بكتابة كلمة المرور الخاصة بك وتخزينها بشكل آمن."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Save it in a trusted password manager or write down your passphrase and store it securely."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save it in a trusted password manager or write down your passphrase and store it securely."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guárdalo en un administrador de contraseñas de confianza o anota tu frase de contraseña y guárdala de forma segura."
