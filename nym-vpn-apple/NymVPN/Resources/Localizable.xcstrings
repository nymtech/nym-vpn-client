          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paga con tarjeta, cripto o dinero en efectivo. No se requiere un correo electrónico. Las pruebas de conocimiento cero hacen que tus pagos sean invinculables a tus actividades en línea."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Pay with card, crypto, or cash - no email required. Zero-knowledge proofs make your payments unlinkable to your online activities."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Payez avec une carte, une cryptomonnaie ou de l'argent - pas d'email requis. Vos paiements ne sont pas reliés à vos activités en ligne."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कार्ड, क्रिप्टोकरेंसी या नकद से भुगतान करें - ईमेल की आवश्यकता नहीं है। ज़ीरो-नॉलेज प्रूफ़ आपके भुगतानों को आपकी ऑनलाइन गतिविधियों से लिंक होने से रोकते हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Pay with card, crypto, or cash - no email required. Zero-knowledge proofs make your payments unlinkable to your online activities."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paga con carta, criptovaluta o contanti - nessuna email richiesta. Le prove della conoscenza rendono i tuoi pagamenti non collegabili alle tue attività online."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カード、暗号、または現金で支払う - 電子メールは必要ありません。ゼロ知識証明は、あなたの支払いをオンライン活動とリンクできないようにします。"
          }
