    "daemonInstall.thirdStep" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يكشف NymVPN تلقائياً التغييرات ويبلغك عن التثبيت الناجح. إذا لم يحدث أي شيء، اتصل بنا"
