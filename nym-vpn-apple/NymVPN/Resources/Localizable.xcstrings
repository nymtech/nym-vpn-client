    "errorReason.sameEntryAndExitGateway" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "للخصوصية، لن يستخدم NymVPN نفس الخادم للدخول والخروج. أعد الاتصال أو اختر مواقع مختلفة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "গোপনীয়তার জন্য NymVPN একই সার্ভারকে এন্ট্রি ও এক্সিট হিসেবে ব্যবহার করে না। পুনরায় সংযোগ করুন বা ভিন্ন লোকেশন নির্বাচন করুন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "For privacy, NymVPN won't use the same server for entry and exit. Reconnect or choose different locations."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aus Gründen der Privatsphäre wird NymVPN nicht den gleichen Server für Ein- und Austritt nutzen. Verbinde dich erneut oder wähle verschiedene Standorte."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "For privacy, NymVPN won't use the same server for entry and exit. Reconnect or choose different locations."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For privacy, NymVPN won't use the same server for entry and exit. Reconnect or choose different locations."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para la privacidad, NymVPN no utilizará el mismo servidor para la entrada y salida. Reconexión o elija diferentes ubicaciones."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای حفظ حریم خصوصی، NymVPN از یک سرور واحد برای ورودی و خروجی استفاده نمی‌کند. دوباره متصل شوید یا مکان‌های متفاوتی را انتخاب کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour des raisons de confidentialité, NymVPN n'utilisera pas le même serveur pour l'entrée et la sortie. Reconnectez-vous ou choisissez des emplacements différents."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्राइवेसी के लिए, NymVPN प्रवेश और निकास के लिए समान गेटवे का उपयोग नहीं करेगा। फिर से कनेक्ट करें या विभिन्न स्थान चुनें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "For privacy, NymVPN won't use the same server for entry and exit. Reconnect or choose different locations."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per la privacy, NymVPN non utilizzerà lo stesso server per entrare ed uscire. Riconnetti o scegli posizioni diverse."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プライバシーを守るために、NymVPNはエントリと終了に同じサーバーを使用しません。再接続または別の場所を選択します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para privacidade, a NymVPN não usará o mesmo servidor para entrada e saída. Reconecte ou escolha locais diferentes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для обеспечения конфиденциальности NymVPN не использует один и тот же сервер для входа и выхода. Переподключитесь или выберите другие местоположения."
