        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ट्रैफ़िक को Nym मिक्सनेट के माध्यम से रूट करने के लिए इसे अपने ब्राउज़र की प्रॉक्सी सेटिंग्स में जोड़ें।"
          }
