    "errorReason.sameEntryAndExitGateway" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "For privacy, NymVPN won't use the same gateway for entry and exit. Reconnect or choose different locations."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "new",
