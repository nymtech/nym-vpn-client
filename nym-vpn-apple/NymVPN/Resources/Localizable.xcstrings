        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NymVPN পরিবর্তনগুলো স্বয়ংক্রিয়ভাবে শনাক্ত করে এবং সফল ইনস্টলেশন সম্পর্কে আপনাকে জানায়। কিছু না হলে আমাদের সাপোর্ট টিমের সঙ্গে যোগাযোগ করুন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "new",
