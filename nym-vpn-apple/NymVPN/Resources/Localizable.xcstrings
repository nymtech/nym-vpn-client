    "modeSelectionInfo.fastDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تصفح عالي السرعة (250+ ميغابايت ) مع مسار 2 هوب . يستخدم AmneziaWG، نسخة مقاومة للرقابة من WireGuard، مثالية للبث والتصفح السريع والتنزيلات.."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "২-হপ রাউটিংসহ উচ্চগতির ব্রাউজিং (২৫০+ Mbps). AmneziaWG ব্যবহার করা হয়েছে, এটি সেন্সরশিপ-রোধী WireGuard সংস্করণ, স্ট্রিমিং, দ্রুত ব্রাউজিং ও ডাউনলোডের জন্য উপযুক্ত.."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "High-speed browsing (250+ Mbps) with 2-hop routing. Uses AmneziaWG, a censorship-resistant version of WireGuard, ideal for streaming, fast browsing and downloads.."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hochgeschwindigkeits-Surfen (250+ Mbit/s) mit 2-Hop-Routing. Verwendet AmneziaWG, eine zensurresistente Version von WireGuard, ideal für Streaming, schnelles Surfen und Downloads."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "High-speed browsing (250+ Mbps) with 2-hop routing. Uses AmneziaWG, a censorship-resistant version of WireGuard, ideal for streaming, fast browsing and downloads.."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "High-speed browsing (250+ Mbps) with 2-hop routing. Uses AmneziaWG, a censorship-resistant version of WireGuard, ideal for streaming, fast browsing and downloads.."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Navegación a alta velocidad (250+ Mbps) con enrutamiento de 2 saltos. Utiliza AmneziaWG, una versión resistente a la censura de WireGuard, ideal para streaming, navegación rápida y descargas."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وبگردی پرسرعت (بیش از ۲۵۰ مگابیت بر ثانیه) با مسیریابی دو-پرشی. از AmneziaWG — نسخه‌ای مقاوم در برابر سانسور از WireGuard — استفاده می‌کند و برای استریم، مرور سریع و دانلودها ایده‌آل است.."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La navigation à haute vitesse (250Mbps) avec routage à 2 sauts utilise AmneziaWG, une version résistante à la censure de WireGuard, idéale pour le streaming, la navigation rapide et les téléchargements.."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दो-हॉप रूटिंग के साथ हाई-स्पीड ब्राउज़िंग (250+ Mbps)। यह WireGuard के सेंसरशिप-प्रतिरोधी संस्करण, AmneziaWG का उपयोग करता है, जो स्ट्रीमिंग, तेज़ ब्राउज़िंग और डाउनलोड के लिए आदर्श है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "High-speed browsing (250+ Mbps) with 2-hop routing. Uses AmneziaWG, a censorship-resistant version of WireGuard, ideal for streaming, fast browsing and downloads.."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Navigazione ad alta velocità (250 + Mbps) con routing 2-hop. Utilizza AmneziaWG, una versione resistente alla censura di WireGuard, ideale per lo streaming, la navigazione veloce e il download.."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2ホップルーティング付きの高速ブラウジング(250+Mbps)。WireGuardの検閲対応バージョンAmneziaWGを使用しており、ストリーミング、高速ブラウジング、ダウンロードに最適です。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Navegação de alta velocidade (250+ Mbps) com roteamento de 2 hop. Usa AmneziaWG, uma versão resistente à censura do WireGuard, ideal para streaming, navegação rápida e downloads.."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Высокоскоростной браузинг (250+ Мбит/с) с 2-ступенчатой маршрутизацией. Использует AmneziaWG — устойчивую к цензуре версию WireGuard, идеальную для стриминга, быстрого браузинга и загрузок.."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "High-speed browsing (250+ Mbps) with 2-hop routing. Uses AmneziaWG, a censorship-resistant version of WireGuard, ideal for streaming, fast browsing and downloads.."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Високошвидкісний перегляд веб-сторінок (250+ Мбіт/с) із 2-ступеневою маршрутизацією. Використовує AmneziaWG, версію WireGuard, стійку до цензури, яка ідеально підходить для потокового передавання, швидкого перегляду веб-сторінок та завантаження файлів.."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tốc độ duyệt web cao (trên 250 Mbps) với định tuyến 2 bước nhảy. Sử dụng AmneziaWG, một phiên bản WireGuard chống kiểm duyệt, lý tưởng cho việc phát trực tuyến, duyệt web nhanh và tải xuống."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用两跳路由进行高速浏览（250+Mbps）。该模式采用了Amnezia WG，这是一种抗审查的WireGuard版本。该模式是流媒体、日常浏览和文件下载的理想选择。"
          }
        }
      }
    },
