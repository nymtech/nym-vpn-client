          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NymVPN chạy dịch vụ nền (daemon) để giữ cho kết nối của bạn an toàn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NymVPN 运行一个后台服务(守护程序)以保证您的连接安全。"
