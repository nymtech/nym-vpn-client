    "home.modal.noInternetConnection.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبدو أنك غير متصل بالإنترنت. الرجاء التحقق من اتصالك بالإنترنت ومحاولة الاتصال."
          }
        },
        "bn" : {
          "stringUnit" : {
