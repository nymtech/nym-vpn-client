    "onboarding2.subtitle1" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الدفع بالبطاقة أو التشفير أو النقود - لا يوجد بريد إلكتروني مطلوب. أدلة المعرفة الصفرية تجعل مدفوعاتك غير مرتبطة بأنشطتك على الإنترنت."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Pay with card, crypto, or cash - no email required. Zero-knowledge proofs make your payments unlinkable to your online activities."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Pay with card, crypto, or cash - no email required. Zero-knowledge proofs make your payments unlinkable to your online activities."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bezahle mit Karte, Kryptowährung oder Bargeld - keine E-Mail-Adresse nötig. Zero-Knowledge-Proofs sorgen dafür, dass deine Zahlungen nicht mit deinen Online-Aktivitäten in Verbindung gebracht werden können."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
