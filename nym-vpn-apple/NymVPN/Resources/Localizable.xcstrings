        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप इंटरनेट से जुड़े नहीं हैं। कृपया अपने इंटरनेट कनेक्शन की जांच करें और फिर से कनेक्ट करने की कोशिश करें।"
          }
        },
        "hu" : {
          "stringUnit" : {
