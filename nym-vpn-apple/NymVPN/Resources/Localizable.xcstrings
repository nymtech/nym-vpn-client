        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envie informações de erro para nos ajudar a corrigir erros mais rapidamente. Os relatórios passam pelo sistema seguro do Sentry e incluem apenas dados de depuração técnica."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
