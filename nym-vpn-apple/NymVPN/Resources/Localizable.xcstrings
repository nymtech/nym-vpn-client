        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فقط مکان‌ها و سرورهایی را نمایش می‌دهد که از حالت سریع (Fast Mode) و پروتکل QUIC پشتیبانی می‌کنند. برای نمایش تمام سرورها، گزینه‌ی QUIC را غیرفعال کنید "
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
