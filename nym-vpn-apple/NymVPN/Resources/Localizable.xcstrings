    "proxy.socks5.instructions" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضف هذا إلى إعدادات البروكسي في المتصفح الخاص بك لتوجيه حركة المرور من خلال Nym mixnet"
