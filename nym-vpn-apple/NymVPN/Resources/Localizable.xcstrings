    "daemonInstall.daemonText" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يدير NymVPN خدمة خلفية (ديمون) للحفاظ على اتصالك آمن."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NymVPN একটি ব্যাকগ্রাউন্ড সার্ভিস (ডেমন) চালায় যাতে আপনার সংযোগ সুরক্ষিত থাকে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "NymVPN runs a background service (daemon) to keep your connection secure."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NymVPN führt einen Hintergrunddienst (Daemon) aus, um deine Verbindung sicher zu halten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "NymVPN runs a background service (daemon) to keep your connection secure."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NymVPN runs a background service (daemon) to keep your connection secure."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NymVPN ejecuta un servicio de fondo (daemon) para mantener tu conexión segura."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NymVPN یک سرویس پس‌زمینه (daemon) را اجرا می‌کند تا اتصال شما را ایمن نگه دارد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NymVPN exécute un service d'arrière-plan (daemon) pour garder votre connexion sécurisée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NymVPN आपके कनेक्शन को सुरक्षित रखने के लिए एक बैक्ग्राउंड सेवा (Daemon) चलाता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "NymVPN runs a background service (daemon) to keep your connection secure."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NymVPN esegue un servizio in background (demone) per proteggere la tua connessione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NymVPNはバックグラウンドサービス(デーモン)を実行し、接続を安全に保ちます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NymVPN executa um serviço em segundo plano (daemon) para manter sua conexão segura."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NymVPN использует фоновую службу (демон) для поддержания вашего соединения в безопасности."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
