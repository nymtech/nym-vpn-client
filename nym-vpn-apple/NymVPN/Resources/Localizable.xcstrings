        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আমরা আপনার সাবস্ক্রিপশন যাচাই করছি — কোনো ব্যক্তিগত তথ্য কখনোই আপনার পরিচয়ের সঙ্গে যুক্ত করা হয় না"
