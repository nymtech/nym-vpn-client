    "helper.installView.daemonText" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "NymVPN runs a background service (daemon) \u2028to keep your connection secure. It handles encryption and routing, protecting your activity even when the app is closed.\n\nFollow the steps below to install the daemon."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "NymVPN runs a background service (daemon) \u2028to keep your connection secure. It handles encryption and routing, protecting your activity even when the app is closed.\n\nFollow the steps below to install the daemon."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NymVPN runs a background service (daemon) \u2028to keep your connection secure. It handles encryption and routing, protecting your activity even when the app is closed.\n\nFollow the steps below to install the daemon."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NymVPN ejecuta un servicio en segundo plano (daemon) para mantener tu conexión segura. Se encarga de la encriptación y el enrutamiento, protegiendo tu actividad incluso cuando la app está cerrada.\n\nSigue los pasos a continuación para instalar el daemon."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NymVPN یک سرویس پس‌زمینه (دیمون) را اجرا می‌کند \nتا اتصال شما را امن نگه دارد. این سرویس رمزنگاری و مسیریابی را مدیریت می‌کند و فعالیت شما را حتی زمانی که اپلیکیشن بسته است، محافظت می‌کند.\n\nبرای نصب دیمون، مراحل زیر را دنبال کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NymVPN utilise un « daemon » (service en arrière-plan)  pour sécuriser votre connexion. Ce daemon gère le chiffrement et le routage, notamment lorsque l'application NymVPN est fermée, afin que vos activités soient toujours protégées.\n\nSuivez les étapes ci-dessous pour installer le daemon."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NymVPN एक पृष्ठभूमि सेवा (डेमन) चलाता है \n जिससे आपका कनेक्शन सुरक्षित रहता है। यह एन्क्रिप्शन और रूटिंग का प्रबंधन करता है, जिससे आपका कार्य सुरक्षित रहता है, भले ही ऐप बंद हो जाए।\n\nडेमन स्थापित करने के लिए नीचे दिए गए चरणों का पालन करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "NymVPN runs a background service (daemon) \u2028to keep your connection secure. It handles encryption and routing, protecting your activity even when the app is closed.\n\nFollow the steps below to install the daemon."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NymVPNは、接続を安全に保つためにバックグラウンドサービス（デーモン）を実行します。このデーモンが暗号化とルーティングを処理することで、アプリを閉じていてもアクティビティが保護されます。\n\n以下の手順に従って、デーモンをインストールしてください。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "NymVPN runs a background service (daemon) \u2028to keep your connection secure. It handles encryption and routing, protecting your activity even when the app is closed.\n\nFollow the steps below to install the daemon."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O NymVPN usa um serviço em segundo plano (daemon) \n para manter sua conexão segura. O daemon lida com a criptografia e o roteamento, protegendo sua atividade mesmo quando o aplicativo está fechado.\n\nSiga os passos abaixo para instalar o daemon."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NymVPN использует фоновую службу (демон) \nдля обеспечения безопасности вашего соединения. Она обрабатывает шифрование и маршрутизацию, защищая вашу активность даже когда приложение закрыто.\n\nСледуйте инструкциям ниже, чтобы установить демон."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NymVPN, bağlantınızı güvenli tutmak için arka planda bir hizmet (daemon) kullanır. Daemon, uygulama açık olmasa bile şifreleme ve yönlendirmeyi yönetir, böylece çevrimiçi etkinliğiniz her zaman korunur.\n\nDaemon ile ilgili yükleme adımlarını izleyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NymVPN використовує фонову службу (daemon), щоб захистити ваше з'єднання.\n\nDaemon обробляє шифрування та маршрутизацію мережі, навіть коли програма не відкрита, тому ваша онлайн-активність залишається захищеною в будь-який час.\n\nПісля реєстрації та авторизації daemon запускається автоматично."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NymVPN sử dụng một dịch vụ nền (daemon) \nđể giữ kết nối của bạn luôn an toàn. Daemon xử lý mã hóa và định tuyến, bảo vệ hoạt động của bạn ngay cả khi ứng dụng không mở.\n\nHãy làm theo các bước dưới đây để cài đặt daemon."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NymVPN 使用后台服务（守护程序）保障您的连接安全。\n\n守护程序处理加密和网络路由，即使应用未打开，确保您的在线活动全天候受到保护。\n\n按照以下步骤安装守护程序。"
          }
        }
      }
    },
