    "createAccount.dontLoosePassphraseSubtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قم بحفظها في مدير كلمة مرور موثوق بها أو قم بكتابة كلمة المرور الخاصة بك وتخزينها بشكل آمن."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এটি একটি বিশ্বস্ত পাসওয়ার্ড ম্যানেজারে সংরক্ষণ করুন অথবা পাসফ্রেজটি লিখে নিরাপদ স্থানে রাখুন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Save it in a trusted password manager or write down your passphrase and store it securely."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speichere sie in einem vertrauenswürdigen Passwortmanager oder schreibe deine Passphrase auf und bewahre sie sicher auf."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Save it in a trusted password manager or write down your passphrase and store it securely."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save it in a trusted password manager or write down your passphrase and store it securely."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guárdalo en un administrador de contraseñas de confianza o anota tu frase de contraseña y guárdala de forma segura."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آن را در یک «مدیریت رمز عبور مطمئن» ذخیره کنید یا عبارت عبور خود را یادداشت کرده و به صورت ایمن نگهداری کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrez-la dans un gestionnaire de mots de passe fiable ou notez votre phrase secrète et conservez-la en lieu sûr."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसे एक विश्वसनीय पासवर्ड प्रबंधक में सुरक्षित करें या अपना पासफ्रेज़ लिखकर सुरक्षित स्थान पर रखें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Save it in a trusted password manager or write down your passphrase and store it securely."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvarlo in un gestore di password affidabile o annotare la tua frase segreta e memorizzarlo in modo sicuro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Save it in a trusted password manager or write down your passphrase and store it securely."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salve em um gerenciador de senhas confiável ou anote sua frase secreta e armazene-a com segurança."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохраните её в надёжном менеджере паролей или запишите и храните в безопасном месте."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gizli ifadenizi güvenilir bir şifre yöneticisine kaydedin ya da yazıp güvenli bir yerde saklayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зберігайте його в надійному менеджері паролів або запишіть фразу і безпечно зберігайте його."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lưu nó trong trình quản lý mật khẩu đáng tin cậy hoặc ghi lại cụm từ mật khẩu của bạn và lưu trữ một cách an toàn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将其保存在受信任的密码管理器中，或将您的密码短语写下并安全存储。"
          }
        }
      }
    },
