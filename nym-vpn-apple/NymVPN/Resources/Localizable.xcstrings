        }
      }
    },
    "daemonInstall.daemonText1" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتعامل مع التشفير والمسار، ويحمي نشاطك حتى عندما يكون التطبيق مغلقا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এটি এনক্রিপশন ও রাউটিং পরিচালনা করে, অ্যাপ বন্ধ থাকলেও আপনার কার্যকলাপ সুরক্ষিত রাখে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "It handles encryption and routing, protecting your activity even when the app is closed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser kümmert sich um die Verschlüsselung, das Routing und schützt deine Aktivitäten, auch wenn die App geschlossen ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "It handles encryption and routing, protecting your activity even when the app is closed."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It handles encryption and routing, protecting your activity even when the app is closed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maneja el cifrado y el enrutamiento, protegiendo su actividad incluso cuando la aplicación está cerrada."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این برنامه رمزگذاری و مسیریابی را مدیریت می‌کند و حتی زمانی که برنامه بسته است، از فعالیت شما محافظت می‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il gère le chiffrement et le routage, protégeant votre activité même lorsque l'application est fermée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह एन्क्रिप्शन और रूटिंग को संभालता है, तथा ऐप बंद होने पर भी आपकी गतिविधि की सुरक्षा करता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "It handles encryption and routing, protecting your activity even when the app is closed."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gestisce la crittografia e il routing, proteggendo la tua attività anche quando l'app è chiusa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暗号化とルーティングを処理し、アプリが閉じられていてもアクティビティを保護します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ele lida com criptografia e roteamento, protegendo sua atividade, mesmo quando o aplicativo é fechado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Она управляет шифрованием и маршрутизацией, защищая ваши данные даже когда приложение закрыто."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulama kapalı olsa bile etkinliğinizi koruyarak, şifreleme ve yönlendirmeyi bu hizmet yönetir."
          }
        },
        "uk" : {
          "stringUnit" : {
