    "createAccount.dontShareSubtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تشاركها أبدا - حتى مع فريق دعم نيم."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এটি কাউকের সাথেই শেয়ার করবেন না — এমনকি Nym সাপোর্টের সাথেও নয়।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Never share it—not even with Nym Support team."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib sie niemals weiter - auch nicht an das Nym Support Team."
