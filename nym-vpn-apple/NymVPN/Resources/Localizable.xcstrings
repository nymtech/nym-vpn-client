        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"डिवाइस का समय समन्वय में नहीं है। कृपया अपने डिवाइस के समय को इंटरनेट के साथ समन्वयित करें।\""
