    "dns.custom.instructions1" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تكوين DNS الخاص بك لحظر الإعلانات أو تصفية المحتوى أو مقدمي الخدمات المفضلين. اسحب لإعادة ترتيب الأولوية."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "বিজ্ঞাপন ব্লকিং, কনটেন্ট ফিল্টারিং বা পছন্দের প্রোভাইডারের জন্য নিজের DNS কনফিগার করুন। অগ্রাধিকার বদলাতে ড্র্যাগ করুন। এতে Nym-এর সংযোগ সীমিত হতে পারে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Configure your own DNS for ad-blocking, content filtering, or preferred providers. Drag to reorder priority."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konfiguriere deine eigenen DNS für Werbeblockierung, Inhaltsfilterung oder bevorzugte Anbieter. Ziehe die Einträge, um die Priorität neu zu ordnen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Configure your own DNS for ad-blocking, content filtering, or preferred providers. Drag to reorder priority."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configure your own DNS for ad-blocking, content filtering, or preferred providers. Drag to reorder priority."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configure su propio DNS para bloqueo de anuncios, filtrado de contenido o proveedores preferidos. Arrastre para reordenar la prioridad."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DNS دلخواه خود را برای مسدودسازی تبلیغات، فیلتر محتوا یا بروی سرویس‌دهندهٔ دلخواه خود تنظیم کنید. برای تغییر اولویت، بکشید و جابه‌جا کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configurez votre propre DNS pour le blocage de publicité, le filtrage de contenu ou les fournisseurs préférés. Faites glisser pour réorganiser la priorité."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "विज्ञापन अवरोधन, कंटेंट फ़िल्टरिंग या पसंदीदा प्रदाताओं के लिए अपना खुद का DNS कॉन्फ़िगर करें। प्राथमिकता क्रम बदलने के लिए खींचें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Configure your own DNS for ad-blocking, content filtering, or preferred providers. Drag to reorder priority."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configura il tuo DNS per il blocco pubblicitario, il filtraggio dei contenuti o i provider preferiti. Trascina per riordinare la priorità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "広告ブロック、コンテンツフィルタリング、または優先プロバイダ用に独自のDNSを設定します。優先順位を変更するにはドラッグします。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configure seu próprio DNS para bloqueio de anúncios, filtragem de conteúdo ou provedores preferidos. Arraste para reordenar a prioridade."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Настройте собственные DNS-серверы для блокировки рекламы, фильтрации контента или использования предпочтительных провайдеров. Перетаскивайте для изменения приоритета."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Configure your own DNS for ad-blocking, content filtering, or preferred providers. Drag to reorder priority."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Налаштуйте власний DNS для блокування реклами, фільтрування вмісту або обраних провайдерів. Перетягніть, щоб змінити пріоритет."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cấu hình DNS riêng của bạn để chặn quảng cáo, lọc nội dung hoặc chọn nhà cung cấp ưu tiên. Kéo để sắp xếp lại thứ tự ưu tiên. Kéo để sắp xếp lại thứ tự ưu tiên."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "配置您自己的DNS用于广告拦截、内容过滤或使用您喜欢的DNS供应商。拖动以重新排序优先级。"
          }
