    "errorReason.deviceTimeOutOfSync" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وقت الجهاز غير متزامن. الرجاء مزامنة وقت جهازك مع الإنترنت."
          }
        },
        "de" : {
          "stringUnit" : {
