        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसे कभी साझा न करें—यहाँ तक कि Nym सपोर्ट टीम के साथ भी नहीं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "new",
