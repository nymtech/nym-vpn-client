    "gatewayInfo.lastUpdate" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نتيجة الأداء محسوبة من تحميل الخادم ووقت إضافي. التحديث كآخر 24 ساعة. آخر تحديث"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "পারফরম্যান্স স্কোর সার্ভার লোড ও আপটাইম থেকে নির্ধারিত। আপটাইম হিসেবে শেষ ২৪ ঘণ্টার গড় নেওয়া হয়েছে। সর্বশেষ আপডেট:"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Performance score calculated from server load and uptime. Uptime as last 24-hours average. Last update"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Gesamtleistung basiert auf Serverlast und Verfügbarkeit. Die Verfügbarkeit wurde als Durchschnitt der letzten 24 Stunden berechnet. Letzte Aktualisierung"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Performance score calculated from server load and uptime. Uptime as last 24-hours average. Last update"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Performance score calculated from server load and uptime. Uptime as last 24-hours average. Last update"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puntuación de rendimiento calculada a partir de la carga y actualización del servidor. Tiempo de actualización como media de las últimas 24 horas. Última actualización"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "امتیاز عملکرد از بارگذاری سرور و مدت زمان فعال بودن محاسبه میگردد. مدت زمان فعال بودن به صورت میانگین ۲۴ ساعت آخر است. آخرین به‌روزرسانی"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Score de performance calculé à partir de la charge du serveur et du temps de disponibilité. Temps de disponibilité des dernières 24 heures. Dernière mise à jour"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रदर्शन स्कोर सर्वर लोड और अपटाइम से गणना किया गया है। अपटाइम पिछले २४ घंटों के औसत के रूप में। अंतिम अपडेट ।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Performance score calculated from server load and uptime. Uptime as last 24-hours average. Last update"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Punteggio delle prestazioni calcolato dal carico del server e dall'uptime. Uptime come ultima media di 24 ore. Ultimo aggiornamento"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバーの負荷とアップタイムから計算されたパフォーマンススコア。24時間の平均稼働時間。最終更新日時"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pontuação de desempenho calculada a partir da carga do servidor e do tempo de utilização. Atualizado como última média de 24 horas. Última atualização"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показатель производительности, рассчитанный на основе нагрузки и времени обновления. Обновления в течение 24 часов. Последнее обновление"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Performans puanı, sunucu yükü ve çalışma süresi dikkate alınarak hesaplanır. Çalışma süresi, son 24 saatin ortalamasıdır. Son güncelleme"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оцінка продуктивності розраховується на основі навантаження на сервер і часу безвідмовної роботи. Час безвідмовної роботи — середнє значення за останні 24 години. Останнє оновлення"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Điểm hiệu suất được tính dựa trên tải máy chủ và thời gian hoạt động. Thời gian hoạt động được tính trung bình trong 24 giờ qua. Cập nhật lần cuối"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "根据服务器负载和更新计算的性能分数。最新时间为24小时平均值。最后更新"
          }
        }
      }
    },
