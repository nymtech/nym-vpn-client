    "createAccount.whatIsPassphraseExplanation" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عبارة المرور 24 كلمة (المنشأة محليا على جهازك) تعمل كتفاصيل تسجيل الدخول إلى حسابك. عبارة المرور هذه هي الطريقة الوحيدة للوصول إلى حسابك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "24-word passphrase (locally created on your device) serves as your account login details. This passphrase is the only way to access your account."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "24-word passphrase (locally created on your device) serves as your account login details. This passphrase is the only way to access your account."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La contraseña de 24 palabras (creada localmente en su dispositivo) sirve como los datos de inicio de sesión de tu cuenta. Esta contraseña es la única manera de acceder."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "24-word passphrase (locally created on your device) serves as your account login details. This passphrase is the only way to access your account."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La phrase de passe de 24 mots (créée localement sur votre appareil) sert de détails de connexion pour votre compte. Cette phrase de passe est le seul moyen d'accéder à votre compte."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "24-word passphrase (locally created on your device) serves as your account login details. This passphrase is the only way to access your account."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La passphrase a 24 parole (creata localmente sul tuo dispositivo) serve come dettagli di accesso al tuo account. Questa passphrase è l'unico modo per accedere al tuo account."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "24-word passphrase (locally created on your device) serves as your account login details. This passphrase is the only way to access your account."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senha de 24 palavras (criada localmente no seu dispositivo) serve como detalhes de login da sua conta. Esta senha é a única maneira de acessar a sua conta."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A frase secreta de 24 palavras (criada localmente no seu dispositivo) serve como os dados de login da sua conta. Esta frase secreta é a única forma de acessar sua conta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Секретная фраза из 24 слов (создаваемая локально на вашем устройстве) служит данными для входа в ваш аккаунт. Эта фраза — единственный способ получить доступ к вашему аккаунту."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "24 kelimelik gizli ifade (cihazınızda yerel olarak oluşturulur), hesap giriş bilgileriniz olarak kullanılır. Bu ifade, hesabınıza erişmenin tek yoludur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "24-слівна пароль-фраза (створена локально на вашому пристрої) слугує вашими обліковими даними для входу. Ця фраза є єдиним способом доступу до вашого облікового запису."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cụm từ khóa 24 từ (được tạo trên thiết bị của bạn) là thông tin đăng nhập tài khoản của bạn. Cụm từ khóa này là cách duy nhất để truy cập tài khoản của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "24个单词的密码短语（在您的设备上本地创建）作为您的账户登录详情。这个密码短语是访问您账户的唯一方式。"
          }
        }
      }
    },
