# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools

platform :mac do
  desc "Bump version"
  lane :bump_version do
    app_version = ARGV[2]

    puts "App version to set: #{app_version}"

    if app_version.nil? || app_version.strip.empty?
      UI.user_error!("App version is missing. Please provide an app version, e.g., 'fastlane mac bump_version 1.3'")
    end

    project_path = '../NymVPN.xcodeproj'
    project = Xcodeproj::Project.open(project_path)

    allowTargets = ["NymVPN", "NymMixnetTunnel", "NymVPNDaemon"]

    project.targets.each do |projectTarget|
      if allowTargets.include?(projectTarget.name)
        projectTarget.build_configurations.each do |configuration|
          configuration.build_settings["MARKETING_VERSION"] = app_version
          newBundleVersion = (configuration.build_settings["CURRENT_PROJECT_VERSION"].to_i + 1).to_s
          configuration.build_settings["CURRENT_PROJECT_VERSION"] = newBundleVersion
        end
      end
    end

    project.save
  end

  desc "Bump build"
  lane :bump_build do
    project_path = '../NymVPN.xcodeproj'
    project = Xcodeproj::Project.open(project_path)

    allowTargets = ["NymVPN", "NymMixnetTunnel", "NymVPNDaemon"]

    project.targets.each do |projectTarget|
      if allowTargets.include?(projectTarget.name)
        projectTarget.build_configurations.each do |configuration|
          newBundleVersion = (configuration.build_settings["CURRENT_PROJECT_VERSION"].to_i + 1).to_s
          configuration.build_settings["CURRENT_PROJECT_VERSION"] = newBundleVersion
        end
      end
    end

    project.save
  end

  desc "Create temporary keychain, import Developer ID cert, and prepare ASC API key"
  lane :prepare_certificates do
    keychain_name = ENV['TMP_KEYCHAIN_NAME']
    keychain_pass = ENV['TMP_KEYCHAIN_PASS']
    cert_base64   = ENV['DEVELOPER_ID_CERT_BASE64']
    cert_pass     = ENV['DEVELOPER_ID_CERT_PASS']

    UI.user_error!("TMP_KEYCHAIN_NAME or TMP_KEYCHAIN_PASS not provided") if keychain_name.to_s.empty? || keychain_pass.to_s.empty?
    UI.user_error!("DEVELOPER_ID_CERT_BASE64 not provided") if cert_base64.to_s.empty?

    keychain_path = File.expand_path("~/Library/Keychains/#{keychain_name}")
    p12_path = File.join(Dir.tmpdir, "developer_id_cert.p12")

    # Write cert to disk
    File.write(p12_path, Base64.decode64(cert_base64))

    UI.message("🔐 Creating and unlocking temporary keychain: #{keychain_name}")

    create_keychain(
      name: keychain_name,
      password: keychain_pass,
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false,
      add_to_search_list: true
    )

    unlock_keychain(
      path: keychain_path,
      password: keychain_pass,
      add_to_search_list: true,
      set_default: true
    )

    UI.message("📥 Importing Developer ID certificate into keychain...")

    import_certificate(
      certificate_path: p12_path,
      certificate_password: cert_pass,
      keychain_name: keychain_name,
      keychain_password: keychain_pass
    )

    # Allow codesign and Xcode to use the key without prompts
    sh("security set-key-partition-list -S apple-tool:,apple: -s -k #{keychain_pass.shellescape} #{keychain_path.shellescape}")

    UI.success("✅ Certificate imported and keychain ready for signing")

    File.delete(p12_path) if File.exist?(p12_path)
  end
  
  desc "Delete temporary build keychain (cleanup)"
  lane :cleanup_keychain do
    keychain_name = ENV['TMP_KEYCHAIN_NAME']

    if keychain_name.to_s.empty?
      UI.message("ℹ️ No temporary keychain specified — skipping delete.")
    else
      UI.message("🧹 Deleting temporary keychain: #{keychain_name}")
      delete_keychain(name: keychain_name)
      UI.success("✅ Keychain #{keychain_name} deleted.")
    end
  end

  desc "Build unsigned Debug macOS app for PR (using gym)"
  lane :build_debug do
    UI.message("🏗️ Building unsigned Debug macOS app for PR…")

    workspace_path = File.expand_path("../NymVPN.xcworkspace", __dir__)
    output_dir = File.expand_path("build/pr-debug-mac", Dir.pwd)

    UI.message("📁 Using workspace path: #{workspace_path}")
    sh "ls -la #{File.dirname(workspace_path)}"
    sh "find #{File.dirname(workspace_path)} -name '*.xcscheme' || true"

    UI.message("🔍 Running xcodebuild -list to verify schemes...")
    sh "xcrun xcodebuild -list -workspace '#{workspace_path}' || true"

    UI.message("🔄 Resolving Swift packages explicitly before build...")
    sh "xcrun xcodebuild -resolvePackageDependencies -workspace '#{workspace_path}' -scheme NymVPNDaemon || true"

    gym(
      workspace: workspace_path,
      scheme: "NymVPNDaemon",
      configuration: "Debug",
      destination: "platform=macOS,arch=arm64",
      sdk: "macosx",
      clean: true,
      skip_archive: true,
      skip_package_ipa: true,
      skip_codesigning: true,
      derived_data_path: File.expand_path(".DerivedData-macOS", Dir.pwd),
      output_directory: output_dir,
      output_name: "NymVPNDaemon-Debug"
    )

    UI.success("✅ macOS Debug build completed. Products available at #{output_dir}")
    sh "find '#{output_dir}' -type d -name '*.app' -print || true"
  end

  desc "Archive macOS app for QA/Ship with Developer ID signing and Hardened Runtime"
  lane :build_release do
    UI.message("🏗️ Building macOS Release archive (Developer ID)…")

    archive_path = File.expand_path("../build/NymVPNDaemon-macOS.xcarchive", __dir__)
    output_dir   = File.expand_path("../build/export-macos", __dir__)
    workspace_path = File.expand_path("../NymVPN.xcworkspace", __dir__)
    FileUtils.mkdir_p(output_dir)

    identity = ENV['DEVELOPER_ID_APP_IDENTITY'] ||
              "Developer ID Application: Nym Technologies SA (#{ENV['DEVELOPMENT_TEAM']})"

    gym(
      workspace: workspace_path,
      scheme: "NymVPNDaemon",
      configuration: "Release",
      destination: "generic/platform=macOS",
      sdk: "macosx",
      clean: true,
      archive_path: archive_path,
      output_directory: output_dir,
      output_name: "NymVPNDaemon",
      export_method: "developer-id",
      skip_package_ipa: true,
      skip_archive: false,
      codesigning_identity: identity,
      xcargs: [
        "CODE_SIGN_STYLE=Manual",
        "CODE_SIGN_IDENTITY='#{identity}'",
        "DEVELOPMENT_TEAM=#{ENV['DEVELOPMENT_TEAM']}",
        "ENABLE_HARDENED_RUNTIME=YES",
        "OTHER_CODE_SIGN_FLAGS='--timestamp'",
        "PROVISIONING_PROFILE=",
        "PROVISIONING_PROFILE_SPECIFIER="
      ].join(" ")
    )

    app_path = "#{archive_path}/Products/Applications/NymVPN.app"
    UI.message("✅ Archive complete: #{archive_path}")
    UI.message("🔍 Verifying initial app signature...")
    sh "codesign --verify --deep --strict --verbose=2 '#{app_path}'"

    sparkle_path = "#{app_path}/Contents/Frameworks/Sparkle.framework/Versions/B"
    if File.directory?(sparkle_path)
      UI.message("🔏 Re-signing Sparkle helpers...")
      Dir.glob("#{sparkle_path}/**/*").each do |file|
        next if File.directory?(file)
        next unless File.executable?(file)
        sh "codesign --force --options runtime --timestamp --sign '#{identity}' '#{file}'"
      end
      sh "codesign --force --options runtime --timestamp --sign '#{identity}' '#{sparkle_path}'"
    else
      UI.message("ℹ️ Sparkle.framework not found — skipping.")
    end

    UI.message("🔏 Re-signing main app bundle to seal all signatures…")
    sh "codesign --force --deep --options runtime --timestamp --sign '#{identity}' '#{app_path}'"

    UI.message("✅ Final verification and details:")
    sh "codesign --verify --deep --strict --verbose=2 '#{app_path}'"
    sh "spctl --assess --type execute -vvv '#{app_path}' || true"
    sh "codesign -dv --verbose=4 '#{app_path}' || true"

    # Export archive path for GitHub Actions
    sh "echo 'archive_path=#{archive_path}' >> $GITHUB_OUTPUT" if ENV['GITHUB_OUTPUT']
  end

  desc "Notarize and staple a macOS DMG via App Store Connect API key"
  lane :notarize_dmg do
    UI.message("📤 Submitting DMG for notarization via notarytool...")

    release_type = ENV['RELEASE_TYPE'] || "qa"
    dmg_name = case release_type
              when "qa" then "NymVPN_QA.dmg"
              when "ship" then "NymVPN.dmg"
              else "NymVPN_#{release_type}.dmg"
              end

    dmg_path = File.expand_path("../build/dmg/#{dmg_name}", __dir__)
    UI.user_error!("DMG not found at #{dmg_path}") unless File.exist?(dmg_path)

    api_key = app_store_connect_api_key(
      key_id: ENV['ASC_KEY_ID'],
      issuer_id: ENV['ASC_ISSUER_ID'],
      key_content: ENV['ASC_KEY_BASE64'],
      is_key_content_base64: true
    )

    notarize(
      package: dmg_path,
      bundle_id: "net.nymtech.vpn",
      api_key: api_key,
      use_notarytool: true,
      print_log: true,
    )

    UI.message("📎 Stapling notarization ticket to DMG...")
    sh("xcrun stapler staple '#{dmg_path}'")
    sh("xcrun stapler validate '#{dmg_path}'")

    UI.success("✅ DMG notarized and stapled successfully at #{dmg_path}")
  end
end

platform :ios do
  def asc_api_key!
    app_store_connect_api_key(
      key_id: ENV['ASC_KEY_ID'],
      issuer_id: ENV['ASC_ISSUER_ID'],
      key_content: ENV['ASC_KEY_BASE64'],
      is_key_content_base64: true
    )
  end

  desc "Build unsigned Debug iOS app for PR (using gym)"
  lane :build_debug do
    UI.message("🏗️ Building unsigned Debug iOS app for PR...")

    derived_data = File.expand_path(".DerivedData-iOS", Dir.pwd)
    output_dir = File.expand_path("build/pr-debug", Dir.pwd)
    FileUtils.mkdir_p(output_dir)

    gym(
      workspace: "NymVPN.xcworkspace",
      scheme: "NymVPN",
      configuration: "Debug",
      destination: "generic/platform=iOS",
      sdk: "iphoneos",
      clean: true,
      skip_package_ipa: true,
      skip_archive: false,
      derived_data_path: derived_data,
      output_directory: output_dir,
      output_name: "NymVPN-Debug",
      silent: false,
      export_method: "development",
      build_path: output_dir,
      codesigning_identity: "-",
      export_options: {
        method: "development",
        signingStyle: "automatic",
        compileBitcode: false,
        stripSwiftSymbols: true
      },
      xcargs: [
        "CODE_SIGNING_ALLOWED=NO",
        "CODE_SIGN_STYLE=Automatic",
        "DEVELOPMENT_TEAM=",
        "PROVISIONING_PROFILE_SPECIFIER=",
        "CODE_SIGN_IDENTITY=",
        "OTHER_CODE_SIGN_FLAGS=\"--timestamp=none\""
      ].join(" ")
    )

    UI.success("✅ Build completed. Products available at #{output_dir}")
    sh "find '#{output_dir}' -type f -name '*.app' -o -name '*.ipa' -print || true"
  end

  desc "Archive + Export signed IPA for QA/Ship using App Store Connect authentication"
  lane :build_and_export_release do
    UI.message("🏗️ Building and exporting signed iOS app for QA/Ship...")

    release_type = ENV['RELEASE_TYPE'] || "qa"
    archive_path = File.expand_path("build/NymVPN-iOS.xcarchive", Dir.pwd)
    export_dir   = File.expand_path("build/export-#{release_type}", Dir.pwd)
    FileUtils.mkdir_p(export_dir)
    auth_key_path = File.expand_path("../AuthKey.p8", __dir__)

    begin
      if ENV['ASC_KEY_BASE64'].to_s.strip.empty?
        UI.user_error!("❌ Missing ASC_KEY_BASE64 environment variable — cannot create AuthKey.p8")
      end

      File.write(auth_key_path, Base64.decode64(ENV['ASC_KEY_BASE64']))
      UI.message("🔑 Wrote temporary AuthKey.p8 to #{auth_key_path}")

      app_store_connect_api_key(
        key_id: ENV['ASC_KEY_ID'],
        issuer_id: ENV['ASC_ISSUER_ID'],
        key_content: ENV['ASC_KEY_BASE64'],
        is_key_content_base64: true
      )

      keychain_name = ENV['TMP_KEYCHAIN_NAME']
      keychain_path = "/Users/runner/Library/Keychains/#{keychain_name}"

      gym(
        workspace: "NymVPN.xcworkspace",
        scheme: "NymVPN",
        configuration: "Release",
        destination: "generic/platform=iOS",
        sdk: "iphoneos",
        clean: true,
        archive_path: archive_path,
        output_directory: export_dir,
        output_name: "NymVPN",
        export_method: "app-store",
        skip_package_ipa: false,
        skip_archive: false,
        export_options: {
          method: "app-store",
          signingStyle: "automatic",
          compileBitcode: false,
          stripSwiftSymbols: true
        },
        export_xcargs: [
          "-allowProvisioningUpdates"
        ].join(" "),
        xcargs: [
          "CODE_SIGN_STYLE=Automatic",
          "CODE_SIGNING_ALLOWED=YES",
          "-allowProvisioningUpdates",
          "-authenticationKeyID #{ENV['ASC_KEY_ID']}",
          "-authenticationKeyIssuerID #{ENV['ASC_ISSUER_ID']}",
          "-authenticationKeyPath #{auth_key_path}",
          "OTHER_CODE_SIGN_FLAGS=--keychain=\"#{keychain_path}\""
        ].join(" ")
      )

      UI.message("📦 Searching for exported IPA in: #{export_dir}")
      ipa_path = Dir.glob("#{export_dir}/*.ipa").first

      if ipa_path
        UI.success("✅ IPA exported successfully: #{ipa_path}")
      else
        UI.user_error!("❌ IPA not found after export. Check Fastlane gym output above.")
      end

      UI.message("📦 Archive path: #{archive_path}")
      UI.message("📦 Export directory: #{export_dir}")

    ensure
      if File.exist?(auth_key_path)
        File.delete(auth_key_path)
        UI.message("🧹 Removed temporary AuthKey.p8")
      end
    end
  end

  desc "Upload an already-exported IPA to TestFlight via App Store Connect API key"
  lane :upload_testflight do |options|
    ipa_path  = options[:ipa_path]
    changelog = options[:changelog] || "Automated CI upload"

    UI.user_error!("ipa_path is required") if ipa_path.to_s.empty?

    UI.message("🚀 Uploading to TestFlight...")

    pilot(
      api_key: asc_api_key!,
      ipa: ipa_path,
      changelog: changelog,
      skip_submission: false,
      skip_waiting_for_build_processing: true
    )
  end
end