# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools

# --- App Store metadata upload (localized release notes) ---
# Uploads the public App Store "What's new" (localized release notes) only — no binary,
# no screenshots. The build still reaches TestFlight via the existing app-store-connect
# publish step; this only adds the public store notes on release.
# Reads notes from nym-vpn-apple/fastlane/metadata/<locale>/release_notes.txt
# (generated by scripts/store-changelog). Reuses the App Store Connect API key.
#
# Required env: ASC_KEY_ID, ASC_ISSUER_ID, and either ASC_KEY (base64 .p8) or ASC_KEY_PATH.
# Optional env: ASC_APP_IDENTIFIER (default net.nymtech.vpn).

def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_content: ENV["ASC_KEY"],         # base64-encoded .p8 (preferred in CI)
    key_filepath: ENV["ASC_KEY_PATH"],   # or a path to the .p8 on disk
    is_key_content_base64: true
  )
end

def deliver_release_notes(asc_platform)
  deliver(
    api_key: asc_api_key,
    app_identifier: ENV.fetch("ASC_APP_IDENTIFIER", "net.nymtech.vpn"),
    platform: asc_platform,              # "ios" or "osx"
    metadata_path: "./fastlane/metadata",
    skip_binary_upload: true,
    skip_screenshots: true,
    skip_metadata: false,
    run_precheck_before_submit: false,
    submit_for_review: false,            # upload notes only; submission stays a separate decision
    force: true                          # non-interactive (no HTML preview prompt)
  )
end

platform :mac do
  desc "Bump version"
  lane :bump_version do
    app_version = ARGV[2]

    puts "App version to set: #{app_version}"

    if app_version.nil? || app_version.strip.empty?
      UI.user_error!("App version is missing. Please provide an app version, e.g., 'fastlane mac bump_version 1.3'")
    end

    project_path = '../NymVPN.xcodeproj'
    project = Xcodeproj::Project.open(project_path)

    allowTargets = ["NymVPN", "NymMixnetTunnel", "NymVPNDaemon", "NymVPND"]

    project.targets.each do |projectTarget|
      if allowTargets.include?(projectTarget.name)
        projectTarget.build_configurations.each do |configuration|
          configuration.build_settings["MARKETING_VERSION"] = app_version
        end
      end
    end

    project.save
  end

  desc "Bump build"
  lane :bump_build do |options|
    # Optionally passed build number (string or int)
    provided_build = options[:build].to_i if options[:build]

    project_path = '../NymVPN.xcodeproj'
    project = Xcodeproj::Project.open(project_path)

    allowTargets = ["NymVPN", "NymMixnetTunnel", "NymVPNDaemon", "NymVPND"]

    project.targets.each do |projectTarget|
      next unless allowTargets.include?(projectTarget.name)

      projectTarget.build_configurations.each do |configuration|
        current = configuration.build_settings["CURRENT_PROJECT_VERSION"].to_i
        new_build = provided_build && provided_build > 0 ? provided_build : (current + 1)

        configuration.build_settings["CURRENT_PROJECT_VERSION"] = new_build.to_s
        UI.message("✅ #{projectTarget.name}: #{current} → #{new_build}")
      end
    end

    project.save
  end

  desc "Upload localized App Store release notes (metadata only) for macOS"
  lane :upload_metadata do
    deliver_release_notes("osx")
  end
end

platform :ios do
  desc "Upload localized App Store release notes (metadata only) for iOS"
  lane :upload_metadata do
    deliver_release_notes("ios")
  end
end
