<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

	<uses-permission android:name="android.permission.INTERNET" />
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
	<uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
	<uses-permission android:name="android.permission.WAKE_LOCK" />

	<uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
	<uses-permission
		android:name="android.permission.FOREGROUND_SERVICE_SYSTEM_EXEMPTED"
		android:minSdkVersion="33" />

	<application
		android:hardwareAccelerated="true"
		android:largeHeap="true">

		<service
			android:name="net.nymtech.vpn.backend.service.VpnService"
			android:exported="false"
			android:foregroundServiceType="systemExempted"
			android:permission="android.permission.BIND_VPN_SERVICE"
			android:stopWithTask="false">

			<intent-filter>
				<action android:name="android.net.VpnService" />
				<!-- optional internal action for startForegroundService -->
				<action android:name="net.nymtech.vpn.backend.service.START_FOREGROUND" />
				<action android:name="net.nymtech.vpn.backend.service.START_FROM_API" />
			</intent-filter>

			<meta-data
				android:name="android.net.VpnService.SUPPORTS_ALWAYS_ON"
				android:value="true" />
		</service>

		<receiver
			android:name="net.nymtech.vpn.util.notifications.StopVpnReceiver"
			android:exported="false" />
	</application>
</manifest>
