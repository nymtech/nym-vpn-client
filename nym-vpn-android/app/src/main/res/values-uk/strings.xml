	<!-- Welcome screen -->
	<string name="welcome_continue">Продовжити</string>
	<string name="welcome_descr_start">Допоможіть NymVPN виявити та виправити технічні проблеми! Розгляньте можливість підключення моніторингу помилок (через</string>
	<string name="welcome_descr_sentry_link_text">Вартового</string>
