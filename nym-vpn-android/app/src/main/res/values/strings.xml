	<string name="welcome_descr_sentry_link_text">Sentry</string>
	<string name="welcome_descr_end">) and keeping network stats on. It\'s always anonymous, opt out anytime, and your activities can never be revealed. \n\nThanks for your support!</string>
	<string name="welcome_terms_privacy_text_start">By continuing, you agree to NymVPN\'s</string>
	<string name="welcome_terms_privacy_text_middle">and acknowledge NymVPN\'s</string>
	<string name="welcome_error_toggle_descr">via Sentry</string>
