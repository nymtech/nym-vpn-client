	<!-- Censorship screen -->
	<string name="censorship_description">Enable these features if you\'re experiencing connection issues or NymVPN blocking in your location.</string>
	<string name="censorship_quic_title">Enhanced connection (QUIC)</string>
	<string name="censorship_quic_changes">Changes will apply after reconnect</string>
	<string name="censorship_quic_description">Improves the Fast mode reliability in restrictive networks by wrapping WireGuard traffic in QUIC (HTTP/3) to appear as regular web browsing. Note: Limits entry server options to QUIC-compatible gateways only.</string>
	<string name="censorship_quic_link_text">How QUIC improves connections</string>
	<string name="censorship_quic_link">https://nym.com/features/quic</string>
	<string name="censorship_stealth_title">Stealth API connect</string>
	<string name="censorship_stealth_description">Disguises API requests behind popular, allowed domains to bypass VPN blocking. Automatically used by NymVPN when standard API connection attempts fail.</string>
	<string name="censorship_stealth_link_text">How the Stealth API connect mode works</string>
	<string name="censorship_stealth_link">https://nym.com/features/stealth-api-connect</string>
