	<string name="privacy_title">Data &amp; Privacy</string>
	<string name="privacy_anonymous_stats_title">Anonymous network stats</string>
	<string name="privacy_anonymous_stats_description">Help us build a faster network by sharing anonymous performance data from your region. We use this to optimize speeds, reduce disconnections, and steer server coverage where it\'s needed most. \n\nOnly network performance data is shared – never your browsing activity or personal data.</string>
	<string name="privacy_anonymous_stats_link_text">Learn exactly what\'s shared</string>
	<string name="privacy_anonymous_stats_link">https://nym.com/anonymous-stats</string>
	<string name="privacy_error_reports_title">Error &amp; crash reports</string>
	<string name="privacy_error_reports_description">Send crash info to help us fix bugs faster. Reports go through Sentry’s secure system and include technical debugging data only.</string>
	<string name="privacy_error_reports_link_text">View Sentry Privacy Policy</string>
	<string name="privacy_error_reports_link">https://sentry.io/privacy/</string>
	<string name="privacy_error_reports_restart">Changes will apply after app restart.</string>
	<string name="modal_network_stats_title">Upgrade your experience</string>
	<string name="modal_network_stats_descr">Help improve NymVPN by sharing anonymous network stats from your region. \n\nYour data stays private and secure.</string>
	<string name="modal_network_stats_enable_button">Enable network stats</string>
	<string name="modal_network_stats_not_now_button">Not now</string>
