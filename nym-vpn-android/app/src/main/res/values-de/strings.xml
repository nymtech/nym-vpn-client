	<!-- Data & Privacy screen -->
	<string name="privacy_title">Daten &amp; Privatsphäre</string>
	<string name="privacy_anonymous_stats_title">Anonyme Netzwerkstatistiken</string>
	<string name="privacy_anonymous_stats_description">Helfen Sie uns, ein schnelleres Netzwerk zu bauen, indem Sie anonyme Leistungsdaten aus Ihrer Region teilen. Wir verwenden dies, um die Geschwindigkeit zu optimieren, die Trennung zu reduzieren und die Serverabdeckung dort zu steuern, wo sie am meisten benötigt wird. \n\nNur Netzwerkleistungsdaten werden geteilt – niemals Ihre Surfaktivität oder Ihre persönlichen Daten.</string>
	<string name="privacy_anonymous_stats_link_text">Erfahren Sie genau, was geteilt wird</string>
	<string name="privacy_anonymous_stats_link">https://nym.com/anonymous-stats</string>
	<string name="privacy_error_reports_title">Fehler &amp; Absturzberichte</string>
	<string name="privacy_error_reports_description">Senden Sie Absturzinformationen, um Fehler schneller zu beheben. Berichte gehen durch Sentrys sicheres System und enthalten nur technische Debuggingdaten.</string>
	<string name="privacy_error_reports_link_text">Sentry-Datenschutzerklärung anzeigen</string>
	<string name="privacy_error_reports_link">https://sentry.io/privacy/</string>
	<string name="privacy_error_reports_restart">Änderungen werden nach einem Neustart der App angewendet.</string>
	<string name="modal_network_stats_title">Verbessern Sie Ihre Erfahrung</string>
	<string name="modal_network_stats_descr">Helfen Sie NymVPN zu verbessern, indem Sie anonyme Netzwerkstatistiken aus Ihrer Region teilen. \n\nIhre Daten bleiben privat und sicher.</string>
