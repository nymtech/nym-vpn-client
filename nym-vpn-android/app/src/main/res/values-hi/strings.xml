	<string name="censorship_stealth_description">Protects against VPN blocking by using cover domains. Toggle on to use always, or off to use when normal connections fail.</string>
	<string name="censorship_stealth_link">https://nym.com/features/stealth-api-connect</string>
	<string name="quic">QUIC</string>
